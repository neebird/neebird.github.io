---
import Layout from '../layouts/Layout.astro';

const links = {
  email: "shpirko27@gmail.com",
  linkedin: "https://linkedin.com/in/oleksandrshpirko",
  github: "https://github.com/neebird",
  upwork: "https://www.upwork.com/freelancers/~01b4278668b44bcf42",
  cv: "/cv.pdf",
};

// Flagship first (Billing). Voice agent demoted to a normal tile.
const projects = [
  {
    flagship: true,
    label: "Backend",
    title: "Billing & subscription migration",
    blurb: "Key-based access leaked revenue and blocked recurring billing. I moved it to a metered subscription model with clean upgrade paths and reliable webhooks, without downtime for existing users.",
    tags: ["Django", "PostgreSQL", "Stripe-style billing", "Python", "webhooks"],
    metricHtml: '+<span class="count" data-count="30">0</span>%',
    metricSub: "recurring revenue in 3 months",
  },
  {
    label: "AI / LLM",
    title: "LLM voice agent",
    blurb: "Outbound teams burned hours on dead leads. An LLM agent with answering-machine detection and live human transfer qualifies and routes calls end to end.",
    tags: ["ElevenLabs", "Twilio", "FastAPI", "Whisper"],
    metricHtml: '<span class="count" data-count="470">0</span>/<span class="count" data-count="683">0</span>',
    metricSub: "leads handled autonomously",
  },
  {
    label: "Backend",
    title: "Marketplace repricing bot",
    blurb: "A seller was losing to faster competitors. A FastAPI bot with proxy rotation and scheduled scans reprices automatically.",
    tags: ["FastAPI", "PostgreSQL", "Celery", "Redis"],
    metricHtml: '+<span class="count" data-count="80">0</span>%',
    metricSub: "client sales after launch",
  },
  {
    label: "Backend",
    title: "Real-time arbitrage engine",
    blurb: "Price gaps close in milliseconds. A WebSocket pipeline ingests and reacts to market feeds with low-latency async processing.",
    tags: ["Python", "WebSockets", "asyncio", "Redis"],
    metricHtml: '<span class="count" data-count="1000">0</span>+',
    metricSub: "messages / sec sustained",
  },
  {
    label: "AI / LLM",
    title: "RAG chatbots",
    blurb: "“Add AI on our own docs, no hallucinations.” Retrieval-augmented chatbots with vector search and chunked ingestion, served behind FastAPI.",
    tags: ["LangChain", "pgvector", "Pinecone", "Claude"],
    metricHtml: 'Grounded',
    metricSub: "RAG in production",
  },
];

const ENTR = ["reveal-l", "reveal-r", "reveal-scale", "reveal"];

const stack = {
  "Backend": ["Python", "FastAPI", "Django", "PostgreSQL", "Redis", "Celery", "SQLAlchemy", "WebSockets", "REST APIs", "microservices", "background jobs"],
  "AI / LLM": ["OpenAI", "Anthropic Claude", "ElevenLabs", "Whisper", "Groq", "RAG", "pgvector", "Pinecone", "LangChain", "prompt engineering"],
  "Infra & Tools": ["Docker", "CI/CD", "Linux", "NGINX", "Caddy", "AWS", "DigitalOcean", "Hetzner", "Git", "n8n", "Playwright"],
};

const allStack = Object.values(stack).flat();

const alsoShipped = "monolith → microservices · on-chain screener (Arkham/Nansen) · 17+ Telegram & Discord bots";

const stats = [
  { num: "25", suffix: "+", label: "Upwork jobs done" },
  { num: "4.9", suffix: "★", label: "Top Rated freelancer" },
  { num: "100", suffix: "%", label: "job success" },
];

// Real Upwork client feedback (verbatim)
const testimonials = [
  { text: "Oleksandr did an excellent job on this project. He delivered everything professionally, on time, and with great attention to detail.", who: "Ayman E.", role: "API-based marketplace" },
  { text: "Oleksandr was very knowledgeable and efficient with this project. Very grateful to have his help and will definitely hire him again.", who: "Julie H.", role: "Python automation" },
  { text: "Oleksandr is excellent! He jumped on our project and found and fixed our problem in a couple of hours, after we had spent a week looking for it. I wouldn't go anywhere else now.", who: "Ron F.", role: "ElevenLabs voice agent" },
];
---

<Layout>
  <!-- ===================== 1 · HERO ===================== -->
  <section id="top" class="relative min-h-[88vh] flex items-center overflow-hidden">
    <div class="aurora parallax" aria-hidden="true"><span class="a1"></span><span class="a2"></span></div>
    <div class="absolute inset-0 opacity-[0.4]" style="background-image: radial-gradient(circle at 1px 1px, var(--color-border-strong) 1px, transparent 0); background-size: 38px 38px; mask-image: radial-gradient(ellipse 70% 60% at 30% 40%, black 30%, transparent 75%);" aria-hidden="true"></div>

    <div class="max-w-5xl mx-auto px-5 md:px-8 w-full relative z-10 pt-28 pb-20">
      <div class="hero-animate delay-1 inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-border bg-surface mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-60"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
        </span>
        <span class="font-mono text-xs text-text-secondary tracking-tight">Top Rated on Upwork · remote (EU)</span>
      </div>

      <h1 class="font-bold tracking-tight mb-7" style="font-size: clamp(2.5rem, 5.5vw, 3.5rem); line-height: 1.05;">
        <span class="scramble">Python Backend</span><br />
        &amp; <span class="text-accent-strong scramble">AI Integration</span> <span class="scramble">Engineer</span>
      </h1>

      <p class="hero-animate delay-4 prose-measure text-text-secondary mb-10" style="font-size: 1.375rem; line-height: 1.5;">
        I build production backends and AI systems that ship: FastAPI services, LLM voice agents, RAG, and real-time pipelines.
      </p>

      <div class="hero-animate delay-5 flex flex-wrap items-center gap-5">
        <a href="#contact" class="magnetic group inline-flex items-center gap-2 px-6 py-3 bg-accent text-on-accent rounded-lg font-medium text-base hover:bg-accent-hover transition-colors duration-200">
          Get in touch
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={links.cv} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 text-base text-text-secondary hover:text-text transition-colors duration-200">
          Open to remote roles
          <span class="text-accent-strong ul-grow">· View CV →</span>
        </a>
      </div>
    </div>

    <!-- scroll cue -->
    <div class="hero-animate delay-6 absolute bottom-7 left-1/2 -translate-x-1/2 text-text-muted" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="scroll-cue"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </div>
  </section>

  <!-- ===================== 2 · SELECTED WORK ===================== -->
  <section id="work" class="section-pad border-t border-border">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <div class="mb-12">
        <span class="font-mono text-sm text-accent-strong tracking-widest uppercase">Selected work</span>
        <h2 class="sweep font-semibold mt-3" style="font-size: clamp(1.9rem, 4vw, 2.4rem);">Systems I've shipped</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((p, idx) => (
          p.flagship ? (
            <article class="reveal glow-card tilt rounded-2xl bg-surface border border-border p-8 md:col-span-2 md:flex md:items-end md:justify-between md:gap-10" data-tilt-max="7" data-tilt-scale="1.012" data-tilt-persp="1400">
              <span class="glow" aria-hidden="true"></span>
              <div class="md:max-w-lg">
                <span class="block font-mono text-xs tracking-wider uppercase text-accent-strong mb-4">{p.label} · flagship</span>
                <h3 class="font-semibold text-text text-2xl mb-3">{p.title}</h3>
                <p class="text-text-secondary leading-relaxed text-lg mb-6">{p.blurb}</p>
                <div class="flex flex-wrap gap-1.5">
                  {p.tags.map((t) => (
                    <span class="chip font-mono text-xs px-2 py-1 rounded-md bg-surface-2 text-text-secondary">{t}</span>
