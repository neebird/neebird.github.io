        Backend that can't keep up, or an AI feature you want shipped? Reach out. I usually reply within a day.
      </p>

      <div class="reveal flex items-center justify-center gap-4 flex-wrap">
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="magnetic social-ico inline-flex items-center justify-center w-14 h-14 rounded-full border border-border-strong text-text-secondary hover:text-[#0A66C2] hover:border-[#0A66C2]">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
        </a>
        <a href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="tilt glow-card inline-flex items-center justify-center w-14 h-14 rounded-full border border-border-strong text-text-secondary hover:text-text hover:border-text transition-colors duration-300" data-tilt-max="26" data-tilt-scale="1.12" data-tilt-persp="320">
          <span class="glow" aria-hidden="true"></span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
        <a href={links.upwork} target="_blank" rel="noopener noreferrer" aria-label="Upwork" class="social-ico ico-up inline-flex items-center justify-center w-14 h-14 rounded-full border border-border-strong text-text-secondary hover:text-[#14A800] hover:border-[#14A800]">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703 0 1.49-1.211 2.702-2.702 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.548-1.405-.002-2.543-1.143-2.545-2.548V3.492H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-1.19c.529 1.107 1.182 2.229 1.974 3.221l-1.673 7.873h2.797l1.213-5.71c1.063.679 2.285 1.109 3.686 1.109 3 0 5.439-2.452 5.439-5.45 0-3-2.439-5.439-5.439-5.439z"/></svg>
        </a>
        <a href={`mailto:${links.email}`} aria-label="Email" class="social-ico ico-mail inline-flex items-center justify-center w-14 h-14 rounded-full border border-border-strong text-text-secondary hover:text-accent-strong hover:border-accent-strong">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"/><path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"/></svg>
        </a>
      </div>
      <p class="reveal mt-7 font-mono text-sm text-text-muted">{links.email}</p>
    </div>
  </section>

  <!-- ===================== SCRIPTS ===================== -->
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(any-pointer: fine)').matches;

    // Hero load-in
    requestAnimationFrame(() => document.body.classList.add('loaded'));

    // Scramble / decrypt reveal on .scramble text (one-shot, staggered)
    if (!reduce) {
      const CH = '!<>-_\\/[]{}=+*?#';
      const rnd = () => CH[(Math.random() * CH.length) | 0];
      const garble = (t: string) => t.replace(/[^ ]/g, rnd);
      const run = (el: HTMLElement, text: string) => {
        let f = 0; const len = text.length; const dur = len * 2 + 14;
        const step = () => {
          let out = '';
          for (let i = 0; i < len; i++) out += text[i] === ' ' ? ' ' : (f >= i * 2 ? text[i] : rnd());
          el.textContent = out;
          if (f++ < dur) requestAnimationFrame(step); else el.textContent = text;
        };
        requestAnimationFrame(step);
      };
      document.querySelectorAll<HTMLElement>('.scramble').forEach((el, i) => {
        const text = el.textContent || '';
        el.textContent = garble(text);
        setTimeout(() => run(el, text), 120 + i * 150);
      });
    }

    // Scroll reveals — IntersectionObserver, varied directions
    {
      const sel = '.reveal, .reveal-l, .reveal-r, .reveal-scale, .clip-reveal, .sweep';
      const els = Array.from(document.querySelectorAll<HTMLElement>(sel));
      if (reduce) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            const sibs = el.parentElement ? Array.from(el.parentElement.children).filter((c) => c.matches(sel)) : [];
            const i = sibs.indexOf(el);
            if (i > 0) el.style.transitionDelay = (i * 0.08) + 's';
            el.classList.add('in');
            io.unobserve(el);
          });
        }, { threshold: 0.14, rootMargin: '0px 0px -40px 0px' });
        els.forEach((el) => {
          // Already in view or scrolled past (e.g. scroll restored on reload) → reveal immediately.
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('in');
          else io.observe(el);
        });
      }
    }

    // Word-by-word heading reveal
    if (!reduce) {
      document.querySelectorAll<HTMLElement>('.split-reveal').forEach((el) => {
        const words = (el.textContent || '').split(/(\s+)/);
        el.textContent = '';
        let i = 0;
        words.forEach((w) => {
          if (!w.trim()) { el.appendChild(document.createTextNode(w)); return; }
          const span = document.createElement('span');
          span.className = 'w';
          span.textContent = w;
          span.style.transitionDelay = (i * 0.045) + 's';
          el.appendChild(span);
          i++;
        });
        el.classList.add('armed');
      });
      const sio = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); sio.unobserve(e.target); } });
      }, { threshold: 0.35 });
      document.querySelectorAll('.split-reveal').forEach(el => sio.observe(el));
    }

    // Buttery pointer interactions — rAF + lerp, fed at the panel's true rate (pointermove +
    // getCoalescedEvents). KEY: `hovering` is set on every sample, not just pointerenter — so a
    // card the cursor is ALREADY over on load (enter never fires) or that scrolls under a still
    // cursor keeps tracking instead of snapping flat when the lerp settles. The loop runs the
    // whole time the cursor is on the card. Rect is re-read on enter and invalidated on
    // scroll / resize / font-swap / shortly after load (first-load layout shifts).
    if (!reduce && fine) {
      let dirty = false;
      const markDirty = () => { dirty = true; };
      addEventListener('scroll', markDirty, { passive: true });
      addEventListener('resize', markDirty, { passive: true });
      document.fonts?.ready.then(markDirty);
      setTimeout(markDirty, 1800);

      document.querySelectorAll<HTMLElement>('.glow-card').forEach((card) => {
        const glow = card.querySelector<HTMLElement>('.glow');
        const isTilt = card.classList.contains('tilt');
        const maxR = parseFloat(card.dataset.tiltMax || '18');
        const maxS = parseFloat(card.dataset.tiltScale || '1.03');
        const persp = parseFloat(card.dataset.tiltPersp || '700');
        let rect: DOMRect | null = null;
        let tRx = 0, tRy = 0, tS = 1, tGx = 0, tGy = 0;
        let rx = 0, ry = 0, s = 1, gx = 0, gy = 0;
        let raf = 0, hovering = false;
        const loop = () => {
          rx += (tRx - rx) * 0.18; ry += (tRy - ry) * 0.18; s += (tS - s) * 0.18;
          gx += (tGx - gx) * 0.22; gy += (tGy - gy) * 0.22;
          if (isTilt) card.style.transform = `perspective(${persp}px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${s.toFixed(3)})`;
          if (glow) glow.style.transform = `translate3d(${gx.toFixed(1)}px, ${gy.toFixed(1)}px, 0)`;
          const settled = Math.abs(tRx - rx) < 0.02 && Math.abs(tRy - ry) < 0.02 && Math.abs(tS - s) < 0.002 && Math.abs(tGx - gx) < 0.4 && Math.abs(tGy - gy) < 0.4;
          if (hovering || !settled) raf = requestAnimationFrame(loop);
          else { raf = 0; card.style.willChange = ''; if (isTilt) card.style.transform = ''; }
        };
        const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
        const sample = (e: { clientX: number; clientY: number }, forceRect: boolean) => {
          if (!rect || dirty || forceRect) { rect = card.getBoundingClientRect(); dirty = false; }
          hovering = true;
          card.style.willChange = 'transform';
          const nx = (e.clientX - rect.left) / rect.width - 0.5;
          const ny = (e.clientY - rect.top) / rect.height - 0.5;
          tRy = nx * maxR; tRx = -ny * maxR; tS = maxS;
          tGx = e.clientX - rect.left - 160; tGy = e.clientY - rect.top - 160;
          kick();
        };
        card.addEventListener('pointerenter', (e) => sample(e, true));
        card.addEventListener('pointermove', (e) => {
          const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : null;
          sample(evs && evs.length ? evs[evs.length - 1] : e, false);
        });
        card.addEventListener('pointerleave', () => { hovering = false; tRx = 0; tRy = 0; tS = 1; rect = null; kick(); });
      });
    }

    // Magnetic CTA
    if (!reduce && fine) {
      document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
        const k = 0.28;
        let cx = 0, cy = 0;
        el.addEventListener('mouseenter', () => { const r = el.getBoundingClientRect(); cx = r.left + r.width / 2; cy = r.top + r.height / 2; });
        el.addEventListener('mousemove', (e) => { el.style.transform = `translate(${(e.clientX - cx) * k}px, ${(e.clientY - cy) * k}px)`; });
        el.addEventListener('mouseleave', () => { el.style.transform = ''; });
      });
    }

    // Count-up on reveal
    const animateCount = (el: HTMLElement) => {
      const raw = el.dataset.count || '0';
      if (!/^\d+$/.test(raw)) return;
      const target = parseInt(raw, 10);
      if (reduce) { el.textContent = target.toLocaleString('en-US'); return; }
      const dur = 1100;
      let start: number | null = null;
      const tick = (ts: number) => {
        if (start === null) start = ts;
        const p = Math.min((ts - start) / dur, 1);
        el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const cio = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { animateCount(e.target as HTMLElement); cio.unobserve(e.target); } });
    }, { threshold: 0.6 });
    document.querySelectorAll<HTMLElement>('.count').forEach(c => cio.observe(c));
  </script>
</Layout>
