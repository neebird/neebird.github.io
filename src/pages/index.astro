                </div>
              </div>
              <div class="mt-7 md:mt-0 md:text-right shrink-0">
                <div class="font-semibold text-text leading-none mb-1.5" style="font-size: 3.25rem;" set:html={p.metricHtml}></div>
                <div class="text-text-muted text-sm">{p.metricSub}</div>
              </div>
            </article>
          ) : (
            <article class={`${ENTR[idx % ENTR.length]} tilt glow-card flex flex-col rounded-2xl bg-surface border border-border p-6`}>
              <span class="glow" aria-hidden="true"></span>
              <span class="font-mono text-xs tracking-wider uppercase text-text-muted mb-4">{p.label}</span>
              <h3 class="font-semibold text-text text-xl mb-3">{p.title}</h3>
              <p class="text-text-secondary leading-relaxed text-base mb-6">{p.blurb}</p>
              <div class="mt-auto">
                <div class="font-semibold text-text leading-none mb-1.5" style="font-size: 2.25rem;" set:html={p.metricHtml}></div>
                <div class="text-text-muted text-sm mb-5">{p.metricSub}</div>
                <div class="flex flex-wrap gap-1.5">
