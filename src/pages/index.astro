            <div class="text-text-secondary">years = <span class="text-text">4</span></div>
            <div class="text-text-secondary">stack = [<span class="text-text">"FastAPI"</span>, <span class="text-text">"LLMs"</span>]</div>
            <div class="text-text-secondary">status = <span class="text-accent-strong">"open to work"</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== 4 · PROOF ===================== -->
  <section class="section-pad border-t border-border">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <div class="grid grid-cols-3 gap-6 md:gap-8 mb-16">
        {stats.map((s) => (
          <div class="reveal-scale">
            <div class="font-semibold text-text leading-none mb-2" style="font-size: clamp(2.25rem, 5vw, 3rem);">
