      <div class="md:col-span-5 reveal-r">
        <div class="lift rounded-2xl border border-border bg-surface overflow-hidden">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border">
            <span class="w-2.5 h-2.5 rounded-full" style="background:#FF5F57"></span>
            <span class="w-2.5 h-2.5 rounded-full" style="background:#FEBC2E"></span>
            <span class="w-2.5 h-2.5 rounded-full" style="background:#28C840"></span>
            <span class="font-mono text-xs text-text-muted ml-2">engineer.py</span>
