      <a href={links.upwork} target="_blank" rel="noopener noreferrer" class="reveal ul-grow inline-block mt-7 font-mono text-sm text-accent-strong">See all 25+ jobs on Upwork →</a>
    </div>
  </section>

  <!-- ===================== 5 · CONTACT ===================== -->
  <section id="contact" class="section-pad border-t border-border relative overflow-hidden">
    <div class="aurora" style="opacity:0.7" aria-hidden="true"><span class="a2"></span></div>
    <div class="max-w-2xl mx-auto px-5 md:px-8 text-center relative z-10">
      <span class="font-mono text-sm text-accent-strong tracking-widest uppercase">Contacts</span>
      <h2 class="sweep font-semibold mt-3 mb-5" style="font-size: clamp(1.9rem, 4vw, 2.4rem);">Let's work together</h2>
